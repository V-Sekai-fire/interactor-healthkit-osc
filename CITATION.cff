    given-names: "K. S. Ernest (iFire)"
    email: ernest.lee@chibifire.com
    orcid: "https://orcid.org/0000-0003-4570-1436"
license: MIT
repository-code: "https://github.com/V-Sekai-fire/interactor-healthkit-osc"
keywords:
  - healthkit
  - osc
  - vrchat
  - heart-rate
